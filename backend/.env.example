# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection (individual params for local dev)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=admin123
PGDATABASE=todo_app

# On Render / production, use a single DATABASE_URL instead of the above:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173
